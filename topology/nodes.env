# Single source of truth for the testbed's nodes.
#
# Sourced by prepare.sh, netem.sh, up.sh, verify.sh and controller/collect.sh,
# so adding or resizing a node means editing this file and the topology YAML -
# nothing else.
#
# Bash has no dictionaries in the portable sense, so each attribute is a
# variable named <ATTR>_<node> and read back with indirect expansion:
#   ip=$(node_ip edge2)   ->  10.0.2.2
#
# CPUMAX is what /sys/fs/cgroup/cpu.max must contain: "<quota_us> <period_us>",
# i.e. the container may use <quota> microseconds of CPU time per <period>.
# 50000 100000 = half a core. It is checked against the kernel by verify.sh,
# because `docker inspect .HostConfig.NanoCpus` reads 0 on a container that
# containerlab has correctly limited via CpuQuota/CpuPeriod.

LAB=edgegame
CLIENT="client"

# Order matters: it is the order every script reports in, weakest node first.
NODES="edge1 edge2 edge3 cloud"

# ---- edge1: the classic "nearest node" - small, cheap, easily swamped -------
IP_edge1=10.0.1.2
CLIENT_IP_edge1=10.0.1.1
CLIENT_IF_edge1=eth1
CPUMAX_edge1="50000 100000"     # 0.5 core

# ---- edge2: a mid-sized edge site ------------------------------------------
IP_edge2=10.0.2.2
CLIENT_IP_edge2=10.0.2.1
CLIENT_IF_edge2=eth2
CPUMAX_edge2="100000 100000"    # 1 core

# ---- edge3: a large edge site, close to a small regional POP ---------------
IP_edge3=10.0.3.2
CLIENT_IP_edge3=10.0.3.1
CLIENT_IF_edge3=eth3
CPUMAX_edge3="200000 100000"    # 2 cores

# ---- cloud: a regional datacentre - compute to spare, but far --------------
IP_cloud=10.0.4.2
CLIENT_IP_cloud=10.0.4.1
CLIENT_IF_cloud=eth4
CPUMAX_cloud="400000 100000"    # 4 cores

# ---- accessors -------------------------------------------------------------
node_ip()        { local v="IP_$1";        echo "${!v:?unknown node $1}"; }
node_client_ip() { local v="CLIENT_IP_$1"; echo "${!v:?unknown node $1}"; }
node_client_if() { local v="CLIENT_IF_$1"; echo "${!v:?unknown node $1}"; }
node_cpumax()    { local v="CPUMAX_$1";    echo "${!v:?unknown node $1}"; }
ctr()            { echo "clab-$LAB-$1"; }
